# ============================================================
# AttendEase — Environment Configuration Template
# ============================================================

# Flask Backend Configuration
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key
PORT=5000
FLASK_DEBUG=true

# Zepiris Biometric Service Configuration
ZEPIRIS_DEVICE=cpu
ZEPIRIS_SIMILARITY_THRESHOLD=0.50

# Vite Frontend Configuration (leave empty to use Vite dev proxy)
VITE_API_URL=
