From 83fcab42e868b27fd5ae1a456e846e760ec35cfb Mon Sep 17 00:00:00 2001
From: Sidharth Ammisetti <sidharthammisetti.ai@gmail.com>
Date: Sun, 27 Sep 2026 23:17:37 +0530
Subject: [PATCH] config(zepiris): allow overriding similarity threshold via
 ZEPIRIS_SIMILARITY_THRESHOLD

---
 backend/zepiris_service.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/backend/zepiris_service.py b/backend/zepiris_service.py
index 4acba76..62c68ad 100644
--- a/backend/zepiris_service.py
+++ b/backend/zepiris_service.py
@@ -12,6 +12,7 @@ from __future__ import annotations
 
 import base64
 import io
+import os
 import sys
 from pathlib import Path
 from typing import Optional, Tuple, Dict, Any
@@ -48,7 +49,7 @@ class ZepirisService:
 
         self.models_dir = ZEPIRIS_ROOT / "models"
         self.device = "cpu"
-        self.similarity_threshold = 0.50  # InsightFace cosine similarity threshold
+        self.similarity_threshold = float(os.getenv("ZEPIRIS_SIMILARITY_THRESHOLD", "0.50"))  # InsightFace cosine similarity threshold
 
         print("[ZepirisService] Initializing Zepiris ML models...")
 
