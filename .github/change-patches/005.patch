Subject: [PATCH] chore(models): add __repr__ to FacultyProfile model

---
 backend/models.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/backend/models.py b/backend/models.py
index 8fdf6ff..0a1a33f 100644
--- a/backend/models.py
+++ b/backend/models.py
@@ -54,6 +54,9 @@ class FacultyProfile(db.Model):
 
     user = db.relationship("User", backref=db.backref("faculty_profile", uselist=False))
 
+    def __repr__(self):
+        return f"<FacultyProfile {self.faculty_id_code}>"
+
 
 class FaceProfile(db.Model):
     id = db.Column(db.Integer, primary_key=True)
