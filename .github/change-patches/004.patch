From: Sidharth Ammisetti <sidharthammisetti.ai@gmail.com>
Date: Sun, 27 Sep 2026 23:17:32 +0530
Subject: [PATCH] chore(models): add __repr__ to Student model

---
 backend/models.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/backend/models.py b/backend/models.py
index b7f58f5..8fdf6ff 100644
--- a/backend/models.py
+++ b/backend/models.py
@@ -41,6 +41,9 @@ class Student(db.Model):
         cascade="all, delete-orphan",
     )
 
+    def __repr__(self):
+        return f"<Student {self.roll_number}>"
+
 
 class FacultyProfile(db.Model):
     id = db.Column(db.Integer, primary_key=True)
