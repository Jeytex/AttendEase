From eef3338883348c2061577fa4d81959e014a4e6ca Mon Sep 17 00:00:00 2001
From: Sidharth Ammisetti <sidharthammisetti.ai@gmail.com>
Date: Sun, 27 Sep 2026 23:17:37 +0530
Subject: [PATCH] docs(face): add docstrings to register_face and face_status
 endpoints

---
 backend/face_routes.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/backend/face_routes.py b/backend/face_routes.py
index 27d87d9..0731542 100644
--- a/backend/face_routes.py
+++ b/backend/face_routes.py
@@ -14,6 +14,7 @@ face_bp = Blueprint("face", __name__)
 @face_bp.route("/register", methods=["POST"])
 @jwt_required()
 def register_face():
+    """Enroll a student's 512-d face embedding after passing quality and liveness checks."""
     claims = get_jwt()
     if claims.get("role") != "student":
         return jsonify({"error": "Only student accounts can register a face profile"}), 403
@@ -103,6 +104,7 @@ def register_face():
 @face_bp.route("/status", methods=["GET"])
 @jwt_required()
 def face_status():
+    """Return the biometric enrollment status for the currently authenticated student."""
     claims = get_jwt()
     if claims.get("role") != "student":
         return jsonify({"error": "Only student accounts have a face registration status"}), 403
-- 
