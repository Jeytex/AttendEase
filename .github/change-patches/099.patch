From be397119b75d3353489cf9d05459519613cd5c48 Mon Sep 17 00:00:00 2001
From: Sidharth Ammisetti <sidharthammisetti.ai@gmail.com>
Date: Sun, 27 Sep 2026 23:17:44 +0530
Subject: [PATCH] docs(config): add .env.example template for backend and
 frontend settings

---
 .env.example | 15 +++++++++++++++
 1 file changed, 15 insertions(+)
 create mode 100644 .env.example

diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..8c6c804
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,15 @@
+# ============================================================
+# AttendEase — Environment Configuration Template
+# ============================================================
+
+# Flask Backend Configuration
+JWT_SECRET_KEY=replace-with-a-secure-random-secret-key
+PORT=5000
+FLASK_DEBUG=true
+
+# Zepiris Biometric Service Configuration
+ZEPIRIS_DEVICE=cpu
+ZEPIRIS_SIMILARITY_THRESHOLD=0.50
+
+# Vite Frontend Configuration (leave empty to use Vite dev proxy)
+VITE_API_URL=
